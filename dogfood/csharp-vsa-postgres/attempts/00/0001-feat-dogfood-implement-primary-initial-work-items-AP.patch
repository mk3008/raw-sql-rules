diff --git a/examples/csharp-vsa-postgres/src/WorkItems.Api/Features/WorkItems/GetWorkItems/GetWorkItemsEndpoint.cs b/examples/csharp-vsa-postgres/src/WorkItems.Api/Features/WorkItems/GetWorkItems/GetWorkItemsEndpoint.cs
new file mode 100644
index 0000000..e9b2962
