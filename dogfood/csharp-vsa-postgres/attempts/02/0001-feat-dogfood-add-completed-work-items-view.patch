--- /dev/null
+++ b/examples/csharp-vsa-postgres/src/WorkItems.Api/Features/WorkItems/GetCompletedWorkItems/ListCompletedWorkItems.sql
@@ -0,0 +1,15 @@
+SELECT
+    id,
+    title,
+    owner_id,
+    status,
+    priority,
+    created_at,
+    completed_at
+FROM work_items
+WHERE status = 2
+  AND completed_at IS NOT NULL
+  AND (@owner_id IS NULL OR owner_id = @owner_id)
+  AND (@completed_from IS NULL OR completed_at >= @completed_from)
+  AND (@completed_to IS NULL OR completed_at <= @completed_to)
+ORDER BY completed_at DESC, id ASC;
