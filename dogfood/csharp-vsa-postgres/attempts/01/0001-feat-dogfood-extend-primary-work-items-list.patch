diff --git a/examples/csharp-vsa-postgres/src/WorkItems.Api/Features/WorkItems/GetWorkItems/ListWorkItems.TitleAsc.sql b/examples/csharp-vsa-postgres/src/WorkItems.Api/Features/WorkItems/GetWorkItems/ListWorkItems.TitleAsc.sql
new file mode 100644
index 0000000..d93b410
--- /dev/null
+++ b/examples/csharp-vsa-postgres/src/WorkItems.Api/Features/WorkItems/GetWorkItems/ListWorkItems.TitleAsc.sql
@@ -0,0 +1,16 @@
+SELECT
+    id,
+    title,
+    owner_id,
+    status,
+    priority,
+    created_at,
+    completed_at
+FROM work_items
+WHERE (@owner_id IS NULL OR owner_id = @owner_id)
+  AND (@status IS NULL OR status = @status)
+  AND (@created_from IS NULL OR created_at >= @created_from)
+  AND (@created_to IS NULL OR created_at <= @created_to)
+  AND (@min_priority IS NULL OR priority >= @min_priority)
+ORDER BY title ASC, id
+LIMIT @limit;
